# Production Environment Variables for Render / Production Backend Deployment

# Supabase Production Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL Direct Connection URL (Supabase Database Settings -> Connection String)
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google Gemini Gen AI Configuration (Google AI Studio)
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_GENERATION_TEMPERATURE=0.2
GEMINI_GENERATION_MAX_TOKENS=1024
GEMINI_GENERATION_TIMEOUT=30.0

# Text Chunking Settings
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Cross-Encoder Re-ranking
RERANKING_ENABLED=true
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_CANDIDATE_LIMIT=20
RERANKING_TOP_K=5

# CORS Allowed Origins (Comma-separated list of production origins)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
