# Production Environment Variables for Vercel Deployment
# Configure these in your Vercel Project Dashboard: Settings -> Environment Variables

# Supabase Production URL & Public Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Render / Cloud Backend API URL (without trailing slash)
VITE_API_BASE_URL=https://your-backend-api.onrender.com
